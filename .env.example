NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Serveur uniquement (Vercel > Settings > Environment Variables). JAMAIS dans le navigateur. ---
# Clé « service_role » / « secret » de Supabase : nécessaire pour la protection anti-spam.
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : Cloudflare Turnstile (gratuit) pour bloquer les robots
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
